# 台股分析助手設定檔
# 以 # 開頭是註解;不需要的項目保持空白即可。修改後請關閉程式重新開啟。

# AI 新聞解讀(選用,到 console.anthropic.com 取得)
ANTHROPIC_API_KEY=

# FinMind 資料額度(選用)
FINMIND_TOKEN=

# LINE 推播(選用)。LINE_BROADCAST=1 代表發給機器人的全部好友
LINE_CHANNEL_TOKEN=
LINE_USER_ID=
LINE_BROADCAST=

# Telegram 推播(選用)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LINE 每日最多推播幾次(預設 5,用來節省每月免費則數)
LINE_MAX_PER_DAY=

# Email 通知(SMTP)。Gmail 請先開啟兩步驟驗證,再建立「應用程式密碼」填在 EMAIL_PASSWORD(不是登入密碼)
EMAIL_USER=kenneth42.tw@gmail.com
EMAIL_PASSWORD=rxybgavxwndowqid
# 收件人,多人用逗號分隔
EMAIL_TO=kenneth42.tw@gmail.com
# 以下選填:非 Gmail 時填寫,例如 Outlook:smtp.office365.com / 587
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_FROM=
# 每日最多寄幾封(預設 30)
EMAIL_MAX_PER_DAY=
